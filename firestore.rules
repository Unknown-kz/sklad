rules_version = '2';

// Правила доступа к базе. Вставьте целиком в Firebase Console → Firestore → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function isViewer(sellerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/sellers/$(sellerId)/viewers/$(request.auth.uid));
    }

    // Профиль, push-токены, список подключённых продавцов — только сам пользователь
    match /users/{uid} {
      allow read, write: if me(uid);
      match /{sub=**} { allow read, write: if me(uid); }
    }

    // Коды доступа: найти продавца по коду может любой вошедший
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /sellers/{sellerId} {
      allow read: if me(sellerId) || isViewer(sellerId);
      allow write: if me(sellerId);

      // Товары: продавец меняет, подключённые магазины только смотрят
      match /products/{productId} {
        allow read: if me(sellerId) || isViewer(sellerId);
        allow create, update: if me(sellerId)
          && request.resource.data.name is string
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0;
        allow delete: if me(sellerId);
      }

      // Продажи и закуп видит только сам продавец
      match /transactions/{tid} {
        allow read, write: if me(sellerId);
      }

      // Магазины с доступом. Магазин добавляет себя, только если знает текущий код.
      match /viewers/{viewerId} {
        allow read: if me(sellerId) || me(viewerId);
        allow create: if me(viewerId)
          && request.resource.data.code == get(/databases/$(database)/documents/sellers/$(sellerId)).data.code;
        allow delete: if me(sellerId) || me(viewerId);
      }
    }
  }
}
